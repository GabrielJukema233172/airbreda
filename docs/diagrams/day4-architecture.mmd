flowchart TB
    subgraph TOP[" "]
        direction LR
        LMN["RIVM Luchtmeetnet API<br/>NO₂ · NL10240 · hourly"]
        NDW["NDW Open Data<br/>4 A27 sites · per minute"]
        USER["Browser / grader<br/>http://16.192.119.40:8000<br/>GET / · /site/{id} · /health"]
    end

    subgraph AWS["AWS · eu-north-1 (Stockholm)"]
        direction TB
        subgraph SG["Security group airbreda-vm-sg · TCP 8000 public (Day 5) · TCP 22 owner IPs only · Elastic IP 16.192.119.40"]
            subgraph VM["EC2 t3.small · Amazon Linux 2023 · Docker · every container: restart unless-stopped"]
                direction TB
                subgraph NET["Docker network 'airbreda'"]
                    direction LR
                    AIR["air-ingest<br/>hourly · last 50 h<br/>flag stale/null"]
                    TRF["traffic-ingest<br/>hourly · skip -1"]
                    DASH["dashboard · FastAPI :8000<br/>GET / (HTML, refresh 60 s)<br/>GET /site/{id} · GET /health<br/>predict.py + model.pkl (baked in)"]
                    DB[("db · PostgreSQL 16<br/>sensor_readings<br/>owner: airbreda<br/>dashboard_ro: SELECT only")]
                end
                CRON["cron 02:15 UTC · pg_dump"]
            end
        end
        IAM{{"IAM role airbreda-ec2-role (narrowed)<br/>Put/Get ndw/* + backups/* · List those prefixes · no Delete<br/>credentials via IMDSv2, no keys on the VM"}}
        S3[("S3 airbreda-raw-730631<br/>ndw/YYYY-MM-DD/HH-site.csv<br/>backups/postgres/*.sql.gz")]
    end

    subgraph ML["Offline training · developer laptop · infra/retrain.ps1"]
        direction LR
        BUILD["ml/build_training_data.py<br/>(runs on the VM)<br/>NO₂ ⋈ traffic per hour"]
        TRAIN["ml/train_model.py<br/>LinearRegression<br/>pinned = serving versions"]
        TEST["pytest<br/>50 tests"]
        PKL[/"model.pkl → docker build<br/>→ deploy.sh"/]
        BUILD --> TRAIN --> TEST --> PKL
    end

    LMN --> AIR
    NDW --> TRF
    USER -- "HTTP :8000" --> DASH

    AIR -- "upsert" --> DB
    TRF -- "flow + speed totals" --> DB
    TRF -- "raw CSV" --> S3
    CRON -- "dump" --> S3
    DB -- "latest NO₂" --> DASH
    S3 -- "newest complete hour<br/>(cached 60 s)" --> DASH
    AIR -. "/health" .-> DASH
    TRF -. "/health" .-> DASH
    IAM -. "assumed by the VM" .-> VM

    DB -. "NO₂ history" .-> BUILD
    S3 -. "all CSVs" .-> BUILD
    PKL -. "new image" .-> DASH

    style TOP fill:none,stroke:none
    classDef offline stroke-dasharray: 5 5;
    class BUILD,TRAIN,TEST,PKL offline
