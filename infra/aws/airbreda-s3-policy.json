{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOwnPrefixes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::airbreda-raw-730631",
      "Condition": { "StringLike": { "s3:prefix": ["ndw/*", "backups/*"] } }
    },
    {
      "Sid": "ReadWriteRawFilesAndBackups",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::airbreda-raw-730631/ndw/*",
        "arn:aws:s3:::airbreda-raw-730631/backups/*"
      ]
    }
  ]
}
