# ~/airbreda/.env on the EC2 VM. Never commit the real file.
# Read by `docker run --env-file .env` (db, air-ingest, traffic-ingest) and by backup.sh.
POSTGRES_PASSWORD=change-me-letters-and-digits-only
# Same password as above. "db" is the Postgres container's name on the airbreda network.
DATABASE_URL=postgresql://airbreda:change-me-letters-and-digits-only@db:5432/airbreda
S3_BUCKET=airbreda-raw-730631
# The only region the course account allows (Stockholm). boto3 and the AWS CLI read these.
AWS_REGION=eu-north-1
AWS_DEFAULT_REGION=eu-north-1
# No REDIS_HOST: the Day 2 queue is not part of the VM deployment (ADR-0004).
# No AWS keys: the VM's IAM role provides credentials.
